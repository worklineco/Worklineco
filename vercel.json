{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/task-due-reminders",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/autobilling",
      "schedule": "40 3 * * *"
    }
  ]
}
